# Local use: copy this file to .env. Never commit the real .env file.
# Render: enter these values in the service Environment page or Blueprint prompt.
PUBLIC_URL=http://localhost:8000
APP_DOMAIN=:80
ADMIN_PASSWORD=change-this-before-hosting
SESSION_SECRET=change-this-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=generate-a-fernet-key
SMARTAPI_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
